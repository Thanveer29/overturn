# --- Hindsight (memory layer) ---
# Hindsight Cloud (recommended on Windows — see docs/architecture/hindsight-integration.md
# for why the local server's default embeddings path can hit a blocked native DLL under
# a Windows Application Control policy):
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Local OSS server alternative: HINDSIGHT_BASE_URL=http://localhost:8888 (no API key needed)

# --- LLM (Groq recommended per hackathon docs) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Backend ---
DATABASE_URL=sqlite:///./data/overturn.db
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
