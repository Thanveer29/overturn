HINDSIGHT_API_KEY=

# --- LLM (Groq recommended per hackathon docs) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Backend ---
DATABASE_URL=sqlite:///./data/overturn.db
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
